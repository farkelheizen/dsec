#!/bin/zsh

emulate -L zsh
setopt extendedglob pipefail
unsetopt err_exit

readonly DSEC_VERSION=0.1.3
readonly DSEC_SCHEMA=dsec/v1
readonly DSEC_US=$'\x1f'

typeset -ga REC_KIND REC_F1 REC_F2 REC_F3 REC_F4 REC_F5 REC_F6 REC_LINE
typeset -ga NOTE_TEXT
typeset -ga DSEC_TEMP_FILES
typeset -ga MANIFEST_LINES
typeset -gA VAL_MAP SRC_MAP SHADOW_MAP
typeset -gA SECRET_FLAG TYPE_MAP DECL_KIND DECL_SCOPE DECL_ALIAS DECL_TYPE DECL_DESC
typeset -gA FILE_DECL_KIND FILE_DECL_SCOPE FILE_DECL_ALIAS FILE_DECL_TYPE FILE_DECL_DESC
typeset -gA USED_NAMES
typeset -g STRICT_REQUIRED=0 SOURCE_SCOPE=''
typeset -g MANIFEST_PATH='./.dsec'
typeset -g ARG_MANIFEST ARG_TARGET ARG_TARGET_SET
typeset -ga ARG_POSITIONALS
typeset -gA ARG_FLAGS

fail() {
  local exit_code=$1
  shift
  local temporary_file
  for temporary_file in "${DSEC_TEMP_FILES[@]}"; do
    [[ -n $temporary_file ]] && /bin/rm -f -- "$temporary_file"
  done
  print -u2 -r -- "dsec: $*"
  exit "$exit_code"
}

usage() {
  cat <<'EOF'
Usage: dsec [--version|-V] <command> [arguments]

Commands:
  init [manifest|-] [-t|--target TARGET]
  inspect [manifest] [-t|--target TARGET] [--check] [--reveal]
  set [manifest] [-t|--target TARGET] <ENV_VAR> [value]
  run [manifest] [-t|--target TARGET] -- <command> [args...]
  load [manifest] [-t|--target TARGET]
  unload | clear                    Unset values tracked by the wrapper
  export [manifest] [-t|--target TARGET]
                                    Print shell-quoted export statements
  docs | render [manifest] [-t|--target TARGET]
                                    Generate a Markdown documentation block
  completions                       Print Zsh completion code
  help                              Show this help

The default manifest is ./.dsec. {{TARGET}} requires -t/--target, and a
target is rejected when the manifest has no {{TARGET}} token.
Non-secret variables use evar; source scopes do not import undeclared names.
Secrets are masked unless --reveal is used.
EOF
}

version() { print -r -- "dsec $DSEC_VERSION" }

valid_env() {
  [[ $1 =~ '^[A-Za-z_][A-Za-z0-9_]*$' && $1 != _ && $1 != SHLVL ]]
}

validate_regular_file() {
  local file_path=$1 label=$2
  [[ ! -L $file_path && -f $file_path && -r $file_path ]] ||
    fail 1 "$label is missing, unreadable, symlinked, or not a regular file"
}

valid_target() {
  [[ $1 =~ '^[a-z0-9][a-z0-9_-]*$' ]]
}

parse_manifest_args() {
  local allowed_flags=$1 arg
  shift
  ARG_MANIFEST='./.dsec'
  ARG_TARGET='' ARG_TARGET_SET=0
  ARG_POSITIONALS=()
  ARG_FLAGS=()
  while (( $# )); do
    arg=$1
    case $arg in
      -t|--target)
        (( ARG_TARGET_SET == 0 )) || fail 1 "target may be specified only once"
        (( $# >= 2 )) || fail 1 "$arg requires a target"
        valid_target "$2" || fail 1 "invalid target '$2'"
        ARG_TARGET=$2 ARG_TARGET_SET=1
        shift 2
        ;;
      -)
        ARG_POSITIONALS+=("$arg")
        shift
        ;;
      -*)
        if [[ " $allowed_flags " == *" $arg "* ]]; then
          ARG_FLAGS[$arg]=1
          shift
        else
          fail 1 "unknown option '$arg'"
        fi
        ;;
      *)
        ARG_POSITIONALS+=("$arg")
        shift
        ;;
    esac
  done
}

select_manifest_path() {
  local -a paths
  paths=("$@")
  (( ${#paths} <= 1 )) || fail 1 "accepts at most one manifest path"
  (( ${#paths} == 0 )) || ARG_MANIFEST=${paths[1]}
}

load_manifest() {
  local path=$1 target_set=$2 target=$3 allow_stdin=${4:-0} content
  MANIFEST_PATH=$path
  if [[ $path == - ]]; then
    (( allow_stdin )) || fail 1 "stdin manifests are supported only by init"
    content=$(/bin/cat) || fail 1 "could not read manifest from stdin"
  else
    validate_regular_file "$path" "manifest"
    content=$(<"$path") || fail 1 "could not read manifest"
  fi
  substitute_target "$content" "$target_set" "$target"
  content=$REPLY
  MANIFEST_LINES=("${(@f)content}")
  parse_manifest
}

substitute_target() {
  local remaining=$1 target_set=$2 target=$3 result='' token prefix suffix found=0
  while [[ $remaining =~ '^([^{}]*)\{\{([^{}]*)\}\}(.*)$' ]]; do
    prefix=${match[1]} token=${match[2]} suffix=${match[3]}
    [[ $token == TARGET ]] || fail 1 "unsupported manifest placeholder"
    (( target_set )) || fail 1 "manifest uses {{TARGET}}; specify -t or --target"
    result+="$prefix$target"
    remaining=$suffix
    found=1
  done
  [[ $remaining != *'{{'* && $remaining != *'}}'* ]] ||
    fail 1 "malformed manifest placeholder"
  (( found || ! target_set )) || fail 1 "target was supplied but manifest has no {{TARGET}} token"
  REPLY="$result$remaining"
}

trim_horizontal() {
  REPLY=${1##[ $'\t']#}
  REPLY=${REPLY%%[ $'\t']#}
}

split_fields() {
  local line=$1 char next field='' in_regex=0 i
  local -a fields
  fields=()
  for (( i = 1; i <= ${#line}; i++ )); do
    char=${line[i]}
    if [[ $char == '\' && ${line[i+1]-} == '|' ]]; then
      field+=$DSEC_US
      (( i++ ))
      continue
    fi
    if (( ! in_regex )) && [[ $char == '/' && $field == *str ]]; then
      in_regex=1
      field+=$char
      continue
    elif (( in_regex )) && [[ $char == '/' ]]; then
      in_regex=0
      field+=$char
      continue
    fi
    if [[ $char == '|' ]] && (( ! in_regex )); then
      trim_horizontal "$field"
      fields+=("$REPLY")
      field=''
    else
      if [[ $char == '|' ]]; then
        field+=$DSEC_US
      else
        field+=$char
      fi
    fi
  done
  (( ! in_regex )) || return 1
  trim_horizontal "$field"
  fields+=("$REPLY")
  for (( i = 1; i <= ${#fields}; i++ )); do
    fields[i]=${fields[i]//$DSEC_US/|}
  done
  FIELDS=("${fields[@]}")
}

typeset -ga FIELDS

reset_manifest() {
  REC_KIND=() REC_F1=() REC_F2=() REC_F3=() REC_F4=() REC_F5=() REC_F6=() REC_LINE=()
  NOTE_TEXT=()
  FILE_DECL_KIND=() FILE_DECL_SCOPE=() FILE_DECL_ALIAS=() FILE_DECL_TYPE=() FILE_DECL_DESC=()
}

parse_manifest() {
  local file_path=$MANIFEST_PATH line line_no=0 kind field_count i seen_source=0 seen_schema=0 schema=''
  reset_manifest
  SOURCE_SCOPE=''
  for line in "${MANIFEST_LINES[@]}"; do
    (( line_no++ ))
    [[ $line != *$'\r'* ]] || fail 1 "$file_path:$line_no: carriage returns are not supported"
    [[ $line != *$'\0'* ]] || fail 1 "$file_path:$line_no: NUL bytes are not supported"
    [[ $line == [[:space:]]# || -z ${line//[ $'\t']/} ]] && continue
    if [[ $line =~ '^[[:space:]]*#' ]]; then
      if [[ $line =~ '^[[:space:]]*#[[:space:]]*@schema:[[:space:]]*(.*)$' ]]; then
        (( ! seen_schema )) || fail 1 "$file_path:$line_no: duplicate schema header"
        seen_schema=1 schema=${match[1]}
      fi
      continue
    fi
    split_fields "$line" || fail 1 "$file_path:$line_no: unterminated regex literal"
    (( ${#FIELDS} > 0 )) || continue
    kind=${(L)FIELDS[1]}
    field_count=${#FIELDS}
    for (( i = 1; i <= field_count; i++ )); do
      [[ $FIELDS[i] != *$'\n'* ]] || fail 1 "$file_path:$line_no: multiline values are not supported"
    done
    case $kind in
      note)
        (( field_count == 2 )) || fail 1 "$file_path:$line_no: note requires exactly 2 columns"
        REC_KIND+=(note); REC_F1+=("$FIELDS[2]"); REC_F2+=(''); REC_F3+=(''); REC_F4+=(''); REC_F5+=(''); REC_F6+=(''); REC_LINE+=("$line_no")
        NOTE_TEXT+=("$FIELDS[2]")
        ;;
      source)
        (( field_count == 4 )) || fail 1 "$file_path:$line_no: source requires exactly 4 columns"
        (( ! seen_source )) || fail 1 "$file_path:$line_no: duplicate source directive"
        seen_source=1
        valid_scope "$FIELDS[2]" || fail 1 "$file_path:$line_no: invalid scope ID '$FIELDS[2]'"
        [[ $FIELDS[3] == req || $FIELDS[3] == opt ]] || fail 1 "$file_path:$line_no: source mode must be req or opt"
        SOURCE_SCOPE=$FIELDS[2]
        REC_KIND+=(source); REC_F1+=("$FIELDS[2]"); REC_F2+=("$FIELDS[3]"); REC_F3+=("$FIELDS[4]"); REC_F4+=(''); REC_F5+=(''); REC_F6+=(''); REC_LINE+=("$line_no")
        ;;
      var)
        (( field_count == 6 )) || fail 1 "$file_path:$line_no: var requires exactly 6 columns"
        valid_env "$FIELDS[2]" || fail 1 "$file_path:$line_no: invalid environment variable '$FIELDS[2]'"
        valid_type "$FIELDS[3]" || fail 1 "$file_path:$line_no: invalid type specification for '$FIELDS[2]'"
        valid_evar_variable "$FIELDS[2]" || fail 1 "$file_path:$line_no: invalid non-secret variable name '$FIELDS[2]'"
        [[ -z $FIELDS[4] ]] || valid_scope "$FIELDS[4]" || fail 1 "$file_path:$line_no: invalid scope ID '$FIELDS[4]'"
        [[ $FIELDS[5] != *$'\n'* ]] || fail 1 "$file_path:$line_no: multiline defaults are not supported"
        valid_evar_value "$FIELDS[5]" || fail 2 "$file_path:$line_no: default for '$FIELDS[2]' is not single-line UTF-8"
        [[ -z $FIELDS[5] ]] || validate_value "$FIELDS[3]" "$FIELDS[5]" ||
          fail 2 "$file_path:$line_no: default for '$FIELDS[2]' does not match '$FIELDS[3]'"
        [[ ! ${+FILE_DECL_KIND[$FIELDS[2]]} -eq 1 ]] || fail 1 "$file_path:$line_no: duplicate declaration '$FIELDS[2]'"
        REC_KIND+=(var); REC_F1+=("$FIELDS[2]"); REC_F2+=("$FIELDS[3]"); REC_F3+=("$FIELDS[4]"); REC_F4+=("$FIELDS[5]"); REC_F5+=("$FIELDS[6]"); REC_F6+=(''); REC_LINE+=("$line_no")
        FILE_DECL_KIND[$FIELDS[2]]=var FILE_DECL_TYPE[$FIELDS[2]]=$FIELDS[3] FILE_DECL_SCOPE[$FIELDS[2]]=$FIELDS[4] FILE_DECL_DESC[$FIELDS[2]]=$FIELDS[6]
        ;;
      secret)
        (( field_count == 5 )) || fail 1 "$file_path:$line_no: secret requires exactly 5 columns"
        valid_env "$FIELDS[2]" || fail 1 "$file_path:$line_no: invalid environment variable '$FIELDS[2]'"
        valid_type "$FIELDS[3]" || fail 1 "$file_path:$line_no: invalid type specification for '$FIELDS[2]'"
        [[ $FIELDS[4] != *$'\n'* ]] || fail 1 "$file_path:$line_no: multiline aliases are not supported"
        [[ $FIELDS[4] != *'|'* ]] || fail 1 "$file_path:$line_no: aliases cannot contain a pipe"
        [[ ! ${+FILE_DECL_KIND[$FIELDS[2]]} -eq 1 ]] || fail 1 "$file_path:$line_no: duplicate declaration '$FIELDS[2]'"
        REC_KIND+=(secret); REC_F1+=("$FIELDS[2]"); REC_F2+=("$FIELDS[3]"); REC_F3+=("$FIELDS[4]"); REC_F4+=("$FIELDS[5]"); REC_F5+=(''); REC_F6+=(''); REC_LINE+=("$line_no")
        FILE_DECL_KIND[$FIELDS[2]]=secret FILE_DECL_TYPE[$FIELDS[2]]=$FIELDS[3] FILE_DECL_ALIAS[$FIELDS[2]]=${FIELDS[4]:-$FIELDS[2]} FILE_DECL_DESC[$FIELDS[2]]=$FIELDS[5]
        ;;
      const)
        (( field_count == 4 )) || fail 1 "$file_path:$line_no: const requires exactly 4 columns"
        valid_env "$FIELDS[2]" || fail 1 "$file_path:$line_no: invalid environment variable '$FIELDS[2]'"
        [[ ! ${+FILE_DECL_KIND[$FIELDS[2]]} -eq 1 ]] || fail 1 "$file_path:$line_no: duplicate declaration '$FIELDS[2]'"
        REC_KIND+=(const); REC_F1+=("$FIELDS[2]"); REC_F2+=("$FIELDS[3]"); REC_F3+=("$FIELDS[4]"); REC_F4+=(''); REC_F5+=(''); REC_F6+=(''); REC_LINE+=("$line_no")
        FILE_DECL_KIND[$FIELDS[2]]=const FILE_DECL_DESC[$FIELDS[2]]=$FIELDS[4]
        ;;
      *)
        fail 1 "$file_path:$line_no: unknown directive '$FIELDS[1]'"
        ;;
    esac
  done
  for (( i = 1; i <= ${#REC_KIND}; i++ )); do
    if [[ ${REC_KIND[i]} == var && -z ${REC_F3[i]} && -z $SOURCE_SCOPE ]]; then
      fail 1 "$file_path:${REC_LINE[i]}: empty var scope requires a source directive"
    fi
  done
  (( seen_schema )) && [[ $schema == $DSEC_SCHEMA ]] ||
    fail 1 "$file_path: unsupported or missing schema"
}

valid_scope() {
  local scope=$1 part
  local -a parts
  [[ -n $scope && $scope != /* && $scope != */ && $scope != *//* ]] || return 1
  parts=("${(@s:/:)scope}")
  (( ${#parts} == 2 || ${#parts} == 3 )) || return 1
  for part in "${parts[@]:0:2}"; do
    valid_scope_segment "$part" || return 1
  done
  (( ${#parts} == 2 )) || [[ ${parts[3]} == _ ]] || valid_scope_segment "${parts[3]}"
}

valid_scope_segment() {
  [[ $1 =~ '^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$' && $1 != *. ]] &&
    ! reserved_device_name "$1"
}

reserved_device_name() {
  local stem=${1%%.*}
  [[ ${(U)stem} == (CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9]) ]]
}

valid_evar_variable() {
  [[ $1 =~ '^[A-Za-z_][A-Za-z0-9_]{0,127}$' ]] && ! reserved_device_name "$1"
}

normalize_scope() {
  REPLY=$1
  [[ ${1//[^\/]/} == / ]] && REPLY+=/_
  return 0
}

valid_type() {
  local type=$1 base
  [[ $type != *$'\n'* ]] || return 1
  base=${type%\?}
  [[ $base == "$type" || $type == *\? ]] || return 1
  [[ $base != *\?* ]] || return 1
  case $base in
    str|bool|path|int|float) return 0 ;;
    'int['*']')
      local bounds=${base[5,-2]} low high
      low=${bounds%%..*}; high=${bounds#*..}
      [[ $bounds == *..* && ( -n $low || -n $high ) ]] || return 1
      [[ -z $low || $low =~ '^-?[0-9]+$' ]] || return 1
      [[ -z $high || $high =~ '^-?[0-9]+$' ]] || return 1
      [[ -z $low || -z $high ]] || (( low <= high )) || return 1
      return 0
      ;;
    'float['*']')
      local bounds=${base[7,-2]} low high
      low=${bounds%%..*}; high=${bounds#*..}
      [[ $bounds == *..* && ( -n $low || -n $high ) ]] || return 1
      [[ -z $low || $low =~ '^-?[0-9]+([.][0-9]+)?$' ]] || return 1
      [[ -z $high || $high =~ '^-?[0-9]+([.][0-9]+)?$' ]] || return 1
      [[ -z $low || -z $high ]] || (( low <= high )) || return 1
      return 0
      ;;
    enum\(*\))
      local body=${base#enum(}; body=${body%)}
      [[ -n $body && $body != ,* && $body != *, && $body != *,,* ]] || return 1
      return 0
      ;;
    str/*/)
      local regex=${base#str/}
      regex=${regex%/}
      [[ -n $regex ]] || return 1
      [[ '' =~ $regex ]] 2>/dev/null
      local regex_status=$?
      (( regex_status == 0 || regex_status == 1 ))
      return $?
      ;;
    *) return 1 ;;
  esac
}

type_optional() { [[ $1 == *\? ]]; }

expand_path() {
  REPLY=$1
  [[ $REPLY == '~/'* ]] && REPLY="$HOME/${REPLY#~/}"
}

validate_value() {
  local type=$1 value=$2 optional=0 base low high token index
  type_optional "$type" && optional=1
  base=${type%\?}
  if [[ -z $value ]]; then
    (( optional )) && return 0
    return 1
  fi
  [[ $value != *$'\n'* && $value != *$'\r'* ]] || return 1
  case $base in
    str) return 0 ;;
    str/*/)
      local regex=${base#str/}; regex=${regex%/}
      [[ $value =~ $regex ]]
      ;;
    enum\(*\))
      local body=${base#enum(}; body=${body%)}
      local -a choices
      choices=("${(@s:,:)body}")
      (( ${choices[(Ie)$value]} > 0 ))
      ;;
    int|int\[*\])
      [[ $value =~ '^-?[0-9]+$' ]] || return 1
      if [[ $base == int\[*\] ]]; then
        local bounds=${base[5,-2]}
        low=${bounds%%..*}; high=${bounds#*..}
        [[ -z $low ]] || (( value >= low )) || return 1
        [[ -z $high ]] || (( value <= high )) || return 1
      fi
      return 0
      ;;
    float|float\[*\])
      [[ $value =~ '^-?[0-9]+([.][0-9]+)?$' ]] || return 1
      if [[ $base == float\[*\] ]]; then
        local bounds=${base[7,-2]}
        low=${bounds%%..*}; high=${bounds#*..}
        [[ -z $low ]] || (( value >= low )) || return 1
        [[ -z $high ]] || (( value <= high )) || return 1
      fi
      return 0
      ;;
    bool)
      [[ ${(L)value} == true || ${(L)value} == false || $value == 1 || $value == 0 || ${(L)value} == yes || ${(L)value} == no ]]
      ;;
    path)
      expand_path "$value"
      [[ -e $REPLY ]]
      ;;
    *) return 1 ;;
  esac
}

prompt_value() {
  local name=$1 type=$2 default=$3 secret=$4 prompt reply choice
  local base=${type%\?}
  [[ -r /dev/tty ]] || fail 2 "cannot prompt for '$name': no controlling terminal"
  prompt="$name ($type)"
  [[ -n $default ]] && prompt+=" [default: $default]"
  if [[ $base == enum\(*\) ]]; then
    local body=${base#enum(}; body=${body%)}
    local -a choices
    choices=("${(@s:,:)body}")
    prompt+=" choices: "
    for (( choice = 1; choice <= ${#choices}; choice++ )); do
      prompt+="$choice)${choices[choice]} "
    done
  elif [[ $base == str/*/ ]]; then
    prompt+=" matching ${base#str/}"
  elif [[ $base == path ]]; then
    prompt+=" (path; ~/ is expanded)"
  fi
  while true; do
    print -u2 -rn -- "$prompt: "
    if (( secret )); then
      read -r -s reply < /dev/tty || fail 2 "could not read '$name'"
      print -u2
    else
      read -r reply < /dev/tty || fail 2 "could not read '$name'"
    fi
    [[ -z $reply && -n $default ]] && reply=$default
    if [[ $base == enum\(*\) && $reply =~ '^[0-9]+$' ]]; then
      local body=${base#enum(}; body=${body%)}
      local -a choices
      choices=("${(@s:,:)body}")
      if (( reply >= 1 && reply <= ${#choices} )); then reply=${choices[reply]}; fi
    fi
    if [[ -z $reply && $type == *\? ]]; then
      REPLY=''
      return 0
    fi
    if validate_value "$type" "$reply"; then
      REPLY=$reply
      return 0
    fi
    print -u2 -r -- "dsec: invalid value for '$name'; try again"
  done
}

read_input_value() {
  local type=$1 name=$2 secret=$3
  if [[ -r /dev/tty ]]; then
    prompt_value "$name" "$type" '' "$secret"
    return
  fi
  REPLY=''
  return 1
}

backend_fail() { fail 3 "$*" }

shell_quote() {
  REPLY="'${1//\'/\'\\\'\'}'"
}

typeset -g EVAR_OUTPUT EVAR_ERROR EVAR_STATUS

# Preserve trailing newlines and keep backend diagnostics away from the user.
evar_call() {
  local tmp result_status=0
  command -v evar >/dev/null 2>&1 || backend_fail "evar is not installed"
  tmp=$(/usr/bin/mktemp "${TMPDIR:-/tmp}/dsec-evar.XXXXXX") || backend_fail "could not create temporary file"
  DSEC_TEMP_FILES+=("$tmp")
  EVAR_OUTPUT=$(command evar "$@" 2>"$tmp"; local result=$?; print -rn -- '.'; exit "$result") || result_status=$?
  EVAR_OUTPUT=${EVAR_OUTPUT%?}
  EVAR_ERROR=$(<"$tmp")
  /bin/rm -f -- "$tmp" || backend_fail "could not remove temporary file"
  DSEC_TEMP_FILES[-1]=()
  EVAR_STATUS=$result_status
}

valid_evar_value() {
  local -a results
  [[ $1 != *$'\0'* && $1 != *[$'\r\n']* ]] || return 1
  print -rn -- "$1" | /usr/bin/iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1 || return 1
  print -rn -- "$1" | LC_ALL=C /usr/bin/grep -a -E $'\xf4[\x90-\xbf]|[\xf5-\xff]' >/dev/null 2>&1
  results=("${pipestatus[@]}")
  (( results[1] == 0 && results[2] == 1 ))
}

# The only platform-specific boundary: evar and kch are called here.
driver_scope_exists() {
  local scope=$1
  normalize_scope "$scope"; scope=$REPLY
  evar_call exists -- "$scope"
  [[ -z $EVAR_OUTPUT ]] || backend_fail "evar returned unsupported output for scope '$scope'"
  (( EVAR_STATUS == 0 )) && [[ -z $EVAR_ERROR ]] && return 0
  (( EVAR_STATUS == 1 )) && [[ -z $EVAR_ERROR ]] && return 1
  backend_fail "could not check configuration scope '$scope'"
}

driver_scope_load() {
  local scope=$1 line name value
  local -A seen
  normalize_scope "$scope"; scope=$REPLY
  evar_call list -- "$scope"
  (( EVAR_STATUS == 0 )) && [[ -z $EVAR_ERROR ]] || backend_fail "could not enumerate configuration scope '$scope'"
  [[ -z $EVAR_OUTPUT || $EVAR_OUTPUT == *$'\n' ]] || backend_fail "evar returned malformed listing for scope '$scope'"
  EVAR_OUTPUT=${EVAR_OUTPUT%$'\n'}
  for line in "${(@f)EVAR_OUTPUT}"; do
    [[ $line == *=* ]] || backend_fail "evar returned malformed listing for scope '$scope'"
    name=${line%%=*} value=${line#*=}
    valid_evar_variable "$name" && valid_evar_value "$value" && (( ! ${+seen[$name]} )) ||
      backend_fail "evar returned malformed listing for scope '$scope'"
    seen[$name]=1
  done
}

driver_var_get() {
  local scope=$1 key=$2
  normalize_scope "$scope"; scope=$REPLY
  evar_call get -n -- "$scope" "$key"
  if (( EVAR_STATUS == 1 )) && [[ -z $EVAR_OUTPUT && $EVAR_ERROR == "evar: not found: $scope/$key" ]]; then
    return 1
  fi
  (( EVAR_STATUS == 0 )) && [[ -z $EVAR_ERROR ]] && valid_evar_value "$EVAR_OUTPUT" ||
    backend_fail "could not read variable '$key' from scope '$scope'"
  REPLY=$EVAR_OUTPUT
}

driver_var_set() {
  local scope=$1 key=$2 value=$3
  valid_evar_value "$value" || fail 2 "non-secret values must be single-line UTF-8 without NUL"
  normalize_scope "$scope"; scope=$REPLY
  evar_call set "$scope" "$key" --stdin <<< "$value"
  (( EVAR_STATUS == 0 )) && [[ -z $EVAR_OUTPUT && -z $EVAR_ERROR ]] ||
    backend_fail "could not store variable '$key' in scope '$scope'"
}

driver_secret_get() {
  local result_status=0
  command -v kch >/dev/null 2>&1 || backend_fail "kch is not installed; required for secrets"
  REPLY=$(kch get "$1" 2>/dev/null) || result_status=$?
  (( result_status == 0 )) || {
    (( result_status == 44 )) && return 1
    backend_fail "could not retrieve secret alias '$1' (check Keychain access)"
  }
  [[ $REPLY != *$'\n'* ]] || backend_fail "secret alias '$1' contains a multiline value"
}

driver_secret_set() {
  local alias=$1 value=$2 result_status=0
  command -v kch >/dev/null 2>&1 || backend_fail "kch is not installed; required for secrets"
  [[ $value != *$'\n'* && $value != *$'\r'* ]] || fail 2 "multiline secret values are not supported"
  kch get "$alias" >/dev/null 2>&1 || result_status=$?
  if (( result_status == 0 )); then
    result_status=0
    print -rn -- "$value" | kch update "$alias" >/dev/null 2>/dev/null || result_status=$?
  elif (( result_status == 44 )); then
    result_status=0
    print -rn -- "$value" | kch add "$alias" >/dev/null 2>/dev/null || result_status=$?
  fi
  (( result_status == 0 )) || backend_fail "could not store secret alias '$alias' (check Keychain access)"
}

set_value() {
  local key=$1 value=$2 source=$3 secret=${4:-0} type=${5:-}
  [[ $value != *$'\n'* && $value != *$'\r'* ]] || fail 2 "multiline values are not supported"
  if [[ -n $type ]] && ! validate_value "$type" "$value"; then
    fail 2 "value for '$key' does not satisfy type '$type'"
  fi
  if [[ ${type%\?} == path ]]; then
    expand_path "$value"
    value=$REPLY
  fi
  if (( ${+VAL_MAP[$key]} )); then
    SHADOW_MAP[$key]+="${SHADOW_MAP[$key]:+ <- }${SRC_MAP[$key]}"
  fi
  VAL_MAP[$key]=$value
  SRC_MAP[$key]=$source
  SECRET_FLAG[$key]=$secret
  TYPE_MAP[$key]=$type
  USED_NAMES[$key]=1
}

unset_value() {
  local key=$1 source=$2 secret=${3:-0} type=${4:-}
  if (( ${+VAL_MAP[$key]} )); then
    SHADOW_MAP[$key]+="${SHADOW_MAP[$key]:+ <- }${SRC_MAP[$key]}"
    unset "VAL_MAP[$key]"
  fi
  SRC_MAP[$key]=$source
  SECRET_FLAG[$key]=$secret
  TYPE_MAP[$key]=$type
  USED_NAMES[$key]=1
}

resolve_manifest() {
  local manifest=$1 i phase kind name scope alias value type mode
  for (( phase = 1; phase <= 3; phase++ )); do
    for (( i = 1; i <= ${#REC_KIND}; i++ )); do
      kind=${REC_KIND[i]}
      case "$phase:$kind" in
        1:source)
          scope=${REC_F1[i]} mode=${REC_F2[i]}
          if driver_scope_exists "$scope"; then
            driver_scope_load "$scope"
          elif [[ $mode == req ]]; then
            fail 2 "required source scope '$scope' is missing"
          fi
          ;;
        2:var)
          name=${REC_F1[i]} type=${REC_F2[i]} scope=${REC_F3[i]:-$SOURCE_SCOPE}
          DECL_KIND[$name]=var DECL_TYPE[$name]=$type DECL_SCOPE[$name]=$scope DECL_DESC[$name]=${REC_F5[i]}
          USED_NAMES[$name]=1
          if driver_var_get "$scope" "$name"; then value=$REPLY
          else value=''
          fi
          if [[ -n $value ]] && ! validate_value "$type" "$value"; then
            fail 2 "stored value for '$name' does not satisfy type '$type'"
          fi
          [[ -n $value ]] || value=${REC_F4[i]}
          if [[ -n $value ]] && ! validate_value "$type" "$value"; then
            fail 2 "default for '$name' does not satisfy type '$type'"
          fi
          if [[ -z $value && $type != *\? && $STRICT_REQUIRED == 1 ]]; then fail 2 "required variable '$name' is missing"; fi
          if [[ -n $value ]]; then set_value "$name" "$value" "$manifest/var:$scope" 0 "$type"
          else unset_value "$name" "$manifest/var:$scope" 0 "$type"
          fi
          ;;
        2:secret)
          name=${REC_F1[i]} type=${REC_F2[i]} alias=${REC_F3[i]:-$REC_F1[i]}
          DECL_KIND[$name]=secret DECL_TYPE[$name]=$type DECL_ALIAS[$name]=$alias DECL_DESC[$name]=${REC_F4[i]}
          USED_NAMES[$name]=1
          if driver_secret_get "$alias"; then value=$REPLY
          else value=''
          fi
          if [[ -n $value ]] && ! validate_value "$type" "$value"; then
            fail 2 "stored secret for '$name' does not satisfy type '$type'"
          fi
          if [[ -z $value && $type != *\? && $STRICT_REQUIRED == 1 ]]; then fail 2 "required secret '$name' is missing"; fi
          if [[ -n $value ]]; then set_value "$name" "$value" "$manifest/secret:$alias" 1 "$type"
          else unset_value "$name" "$manifest/secret:$alias" 1 "$type"
          fi
          ;;
        3:const)
          set_value "${REC_F1[i]}" "${REC_F2[i]}" "$manifest/const" 0 ''
          DECL_KIND[${REC_F1[i]}]=const DECL_DESC[${REC_F1[i]}]=${REC_F3[i]}
          ;;
      esac
    done
  done
}

parse_manifest_and_resolve() {
  (( $# == 3 )) || fail 1 "internal manifest argument error"
  local manifest=$1 target_set=$2 target=$3
  VAL_MAP=() SRC_MAP=() SHADOW_MAP=() SECRET_FLAG=() TYPE_MAP=() USED_NAMES=()
  DECL_KIND=() DECL_SCOPE=() DECL_ALIAS=() DECL_TYPE=() DECL_DESC=()
  load_manifest "$manifest" "$target_set" "$target"
  resolve_manifest "$manifest"
}

check_resolved() {
  local key
  for key in ${(k)DECL_KIND}; do
    case ${DECL_KIND[$key]} in
      var|secret)
        if (( ! ${+VAL_MAP[$key]} )); then
          [[ ${DECL_TYPE[$key]} == *\? ]] || fail 2 "required variable '$key' is missing"
        elif ! validate_value "${DECL_TYPE[$key]}" "${VAL_MAP[$key]}"; then
          fail 2 "value for '$key' does not satisfy type '${DECL_TYPE[$key]}'"
        fi
        ;;
    esac
  done
}

print_shell_exports() {
  local key value
  for key in ${(ok)VAL_MAP}; do
    value=${VAL_MAP[$key]}
    shell_quote "$value"
    print -r -- "export $key=$REPLY"
  done
}

cmd_export() {
  parse_manifest_args '' "$@"
  select_manifest_path "${ARG_POSITIONALS[@]}"
  parse_manifest_and_resolve "$ARG_MANIFEST" "$ARG_TARGET_SET" "$ARG_TARGET"
  check_resolved
  print_shell_exports
}

cmd_run() {
  local -a arguments command_args
  arguments=()
  while (( $# )) && [[ $1 != -- ]]; do
    arguments+=("$1")
    shift
  done
  (( $# > 0 )) || fail 1 "run requires '--' before the command"
  shift
  (( $# > 0 )) || fail 1 "run requires a command after '--'"
  command_args=("$@")
  parse_manifest_args '' "${arguments[@]}"
  select_manifest_path "${ARG_POSITIONALS[@]}"
  parse_manifest_and_resolve "$ARG_MANIFEST" "$ARG_TARGET_SET" "$ARG_TARGET"
  check_resolved
  local -a env_args
  env_args=()
  local key
  for key in ${(k)VAL_MAP}; do env_args+=("$key=${VAL_MAP[$key]}"); done
  command env "${env_args[@]}" "${command_args[@]}"
  local child_status=$?
  exit "$child_status"
}

cmd_inspect() {
  local reveal=0 check=0 key shown type source shadow item_status note
  parse_manifest_args '--check --reveal' "$@"
  select_manifest_path "${ARG_POSITIONALS[@]}"
  (( ${+ARG_FLAGS[--reveal]} )) && reveal=1
  (( ${+ARG_FLAGS[--check]} )) && check=1
  STRICT_REQUIRED=$check
  parse_manifest_and_resolve "$ARG_MANIFEST" "$ARG_TARGET_SET" "$ARG_TARGET"
  if (( check )); then check_resolved; fi
  print -r -- "Manifest: $MANIFEST_PATH"
  for note in "${NOTE_TEXT[@]}"; do print -r -- "  $note"; done
  print -r -- ''
  printf '%-28s %-22s %-24s %-38s %s\n' 'EXPORTED VARIABLE' 'TYPE' 'EFFECTIVE VALUE' 'SOURCE / SHADOWS' 'STATUS'
  for key in ${(ok)USED_NAMES}; do
    type=${TYPE_MAP[$key]-}
    source=${SRC_MAP[$key]-}
    shadow=${SHADOW_MAP[$key]-}
    if (( ${SECRET_FLAG[$key]:-0} && ! reveal )); then shown='********'
    elif (( ${+VAL_MAP[$key]} )); then shown=${VAL_MAP[$key]}
    else shown='(unset)'
    fi
    item_status='set'
    (( ${+VAL_MAP[$key]} )) || item_status='unset'
    [[ -n $shadow ]] && source+=" <- $shadow"
    printf '%-28s %-22s %-24s %-38s %s\n' "$key" "${type:--}" "${shown[1,24]}" "${source[1,38]}" "$item_status"
  done
}

cmd_set() {
  parse_manifest_args '' "$@"
  (( ${#ARG_POSITIONALS} >= 1 && ${#ARG_POSITIONALS} <= 3 )) ||
    fail 1 "set requires [manifest] <ENV_VAR> [value]"
  local manifest='./.dsec' key value='' value_set=0 first second
  if (( ${#ARG_POSITIONALS} == 3 )); then
    manifest=${ARG_POSITIONALS[1]} key=${ARG_POSITIONALS[2]}
    value=${ARG_POSITIONALS[3]} value_set=1
  elif (( ${#ARG_POSITIONALS} == 2 )); then
    first=${ARG_POSITIONALS[1]} second=${ARG_POSITIONALS[2]}
    if [[ -e $first || $first == - || $first == *.dsec || $first == */* ]] ||
       { ! valid_env "$first" && valid_env "$second"; }; then
      manifest=$first key=$second
    else
      key=$first value=$second value_set=1
    fi
  else
    key=${ARG_POSITIONALS[1]}
  fi
  valid_env "$key" || fail 1 "invalid environment variable '$key'"
  load_manifest "$manifest" "$ARG_TARGET_SET" "$ARG_TARGET"
  local kind=${FILE_DECL_KIND[$key]-} type=${FILE_DECL_TYPE[$key]-}
  [[ -n $kind ]] || fail 2 "undeclared variable '$key'; add a var or secret declaration first"
  local alias='' scope='' secret_flag=0
  case $kind in
    var) scope=${FILE_DECL_SCOPE[$key]:-$SOURCE_SCOPE} ;;
    secret) alias=${FILE_DECL_ALIAS[$key]} secret_flag=1 ;;
    *) fail 1 "'$key' is not stored; only var and secret values can be set" ;;
  esac
  if [[ $kind == secret ]]; then
    alias=${alias:-$key}
    [[ $alias != *$'\n'* && $alias != *$'\r'* && $alias != *'|'* ]] ||
      fail 1 "secret alias must be a single-line value without pipes"
  fi
  if (( ! value_set )); then
    read_input_value "$type" "$key" "$secret_flag" || fail 2 "a value is required when input is not interactive"
    value=$REPLY
  fi
  validate_value "$type" "$value" || fail 2 "value for '$key' does not satisfy type '$type'"
  if [[ $kind == secret ]]; then driver_secret_set "$alias" "$value"
  else driver_var_set "$scope" "$key" "$value"
  fi
  print -r -- "Set $key"
}

preflight_init_backends() {
  local i kind scope
  for (( i = 1; i <= ${#REC_KIND}; i++ )); do
    kind=${REC_KIND[i]}
    case $kind in
      source)
        scope=${REC_F1[i]}
        if driver_scope_exists "$scope"; then
          driver_scope_load "$scope"
        elif [[ ${REC_F2[i]} == req ]]; then
          fail 2 "required source scope '$scope' is missing"
        fi
        ;;
      var)
        command -v evar >/dev/null 2>&1 || backend_fail "evar is not installed; required for variable '${REC_F1[i]}'"
        ;;
      secret)
        command -v kch >/dev/null 2>&1 || backend_fail "kch is not installed; required for secret '${REC_F1[i]}'"
        ;;
    esac
  done
}

cmd_init() {
  parse_manifest_args '' "$@"
  select_manifest_path "${ARG_POSITIONALS[@]}"
  load_manifest "$ARG_MANIFEST" "$ARG_TARGET_SET" "$ARG_TARGET" 1
  preflight_init_backends
  local i kind name type scope alias value default
  for (( i = 1; i <= ${#REC_KIND}; i++ )); do
    kind=${REC_KIND[i]}
    case $kind in
      note) print -r -- "${REC_F1[i]}" ;;
      var)
        name=${REC_F1[i]} type=${REC_F2[i]} scope=${REC_F3[i]:-$SOURCE_SCOPE}
        default=${REC_F4[i]} value=''
        if driver_var_get "$scope" "$name"; then
          value=$REPLY
          if validate_value "$type" "$value"; then
            print -r -- "[ok] $name already set ($scope)"
            continue
          fi
          value=''
        fi
        if [[ -n $default ]]; then
          value=$default
        elif [[ $type != *\? ]]; then
          prompt_value "$name" "$type" '' 0
          value=$REPLY
        else
          continue
        fi
        driver_var_set "$scope" "$name" "$value"
        print -r -- "[ok] stored $name ($scope)"
        ;;
      secret)
        name=${REC_F1[i]} type=${REC_F2[i]} alias=${REC_F3[i]:-$REC_F1[i]}
        if driver_secret_get "$alias"; then
          value=$REPLY
          if validate_value "$type" "$value"; then
            print -r -- "[ok] $name already set (Keychain)"
            continue
          fi
        fi
        [[ $type != *\? ]] || continue
        prompt_value "$name" "$type" '' 1
        value=$REPLY
        driver_secret_set "$alias" "$value"
        print -r -- "[ok] stored $name (Keychain)"
        ;;
    esac
  done
}

cmd_docs() {
  parse_manifest_args '' "$@"
  select_manifest_path "${ARG_POSITIONALS[@]}"
  load_manifest "$ARG_MANIFEST" "$ARG_TARGET_SET" "$ARG_TARGET"
  print -r -- "## Manifest: \`$MANIFEST_PATH\`"$'\n'
  local local_note
  for local_note in "${NOTE_TEXT[@]}"; do print -r -- "$local_note"$'\n'; done
  print -r -- "| Variable | Kind | Type | Required | Default | Description |"
  print -r -- "|---|---|---|---|---|---|"
  local i kind type required def
  for (( i = 1; i <= ${#REC_KIND}; i++ )); do
    kind=${REC_KIND[i]}
    case $kind in
      var|secret)
        type=${REC_F2[i]}; required=yes; [[ $type == *\? ]] && required=no
        def='—'; [[ $kind == var && -n ${REC_F4[i]} ]] && def=${REC_F4[i]}
        print -r -- "| \`${REC_F1[i]}\` | $kind | \`$type\` | $required | $def | ${REC_F5[i]:-${REC_F4[i]}} |"
        ;;
      const)
        print -r -- "| \`${REC_F1[i]}\` | $kind | — | no | — | ${REC_F3[i]} |"
        ;;
    esac
  done
  local quickstart
  shell_quote "$MANIFEST_PATH"
  quickstart="dsec run $REPLY"
  (( ARG_TARGET_SET )) && quickstart+=" -t $ARG_TARGET"
  print -r -- "" "Quickstart: \`$quickstart -- <command>\`"
}

cmd_completions() {
  cat <<'EOF'
# Load after compinit: eval "$(dsec completions)"
_dsec() {
  local -a commands options
  local separator=0 i
  commands=(init inspect set run load unload clear export docs render completions help)
  if (( CURRENT == 2 )); then
    compadd -- $commands
    return
  fi
  case ${words[2]} in
    init|inspect|export|load|docs|render)
      options=(-t --target)
      compadd -- $options
      _files -g '*.dsec'
      ;;
    set)
      options=(-t --target)
      compadd -- $options
      _files -g '*.dsec'
      ;;
    run)
      for (( i = 3; i < CURRENT; i++ )); do
        [[ ${words[i]} == -- ]] && separator=$i
      done
      if (( separator )); then
        _normal
        return
      fi
      compadd -- -t --target
      _files -g '*.dsec'
      ;;
    *)
      compadd -- $commands
      ;;
  esac
}
compdef _dsec dsec
EOF
}

cmd_complete_variables() {
  parse_manifest_args '' "$@"
  select_manifest_path "${ARG_POSITIONALS[@]}"
  load_manifest "$ARG_MANIFEST" "$ARG_TARGET_SET" "$ARG_TARGET"
  local i
  for (( i = 1; i <= ${#REC_KIND}; i++ )); do
    [[ ${REC_KIND[i]} == var || ${REC_KIND[i]} == secret ]] &&
      print -r -- "${REC_F1[i]}"
  done
}

cmd_load() {
  print -u2 -r -- "dsec: load must be invoked through dsec.plugin.zsh or eval \"\$(dsec export [manifest] [-t TARGET])\""
  return 1
}

main() {
  (( $# > 0 )) || { usage; exit 0; }
  case $1 in
    --version|-V) version; exit 0 ;;
    help|-h|--help) usage; exit 0 ;;
  esac
  local command_name=$1
  shift
  case $command_name in
    init) cmd_init "$@" ;;
    inspect) cmd_inspect "$@" ;;
    set) cmd_set "$@" ;;
    run) cmd_run "$@" ;;
    export) cmd_export "$@" ;;
    load) cmd_load "$@" ;;
    unload|clear) print -u2 -r -- "dsec: unload is provided by dsec.plugin.zsh"; return 1 ;;
    docs|render) cmd_docs "$@" ;;
    completions) cmd_completions ;;
    __complete_variables) cmd_complete_variables "$@" ;;
    *) fail 1 "unknown command '$command_name'" ;;
  esac
}

main "$@"
