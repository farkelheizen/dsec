# @schema: dsec/v1
note | MYAPP configuration for {{TARGET}}.
const | MYAPP_ENV | {{TARGET}} | Environment name
secret | MYAPP_GOOGLE_CLIENT_SECRET | str | myapp-{{TARGET}}-google-client-secret | Google OAuth client secret
secret | MYAPP_MCP_SIGNING_KEY | str | myapp-{{TARGET}}-mcp-signing-key | MCP signing key
secret | MYAPP_GOOGLE_ALLOWED_EMAILS | str | myapp-{{TARGET}}-google-allowed-emails | Allowed Google account emails
source | example/myapp/{{TARGET}} | opt | Environment configuration
var | MYAPP_MCP_BASE_URL | str | | | MCP service base URL
var | MYAPP_GOOGLE_CLIENT_ID | str | | | Google OAuth client ID
var | FASTMCP_HOME | str | | | FastMCP home directory
